# Copy to .env next to compose.yaml and fill in the four required values. To generate one:
#   openssl rand -base64 48 | tr -d '/+=\n'

# ---- required ---------------------------------------------------------------------------------
# Django's secret key.
SECRET_KEY=
# The database password. Set it before the first start: PostgreSQL stores it in its volume.
POSTGRES_PASSWORD=
# The token web and worker present to the solver. Any change needs all three restarted.
SOLVER_TOKEN=
# The first password of the System Admin, whose username is `admin`. Read once, at first start;
# change is forced at first login. Changing it here later does nothing.
INITIAL_ADMIN_PASSWORD=

# ---- optional ---------------------------------------------------------------------------------
# The public name of this server, whose DNS already points here, with ports 80 and 443 reachable
# from the internet: Caddy then obtains a Let's Encrypt certificate. Empty: a self-signed certificate.
DOMAIN=
# The hospital's time zone.
TIME_ZONE=Asia/Riyadh
# The image and the version this hospital pins. `docker compose up -d` builds that name from
# the checkout when the image is neither present nor in the registry.
APP_IMAGE=nurse-roster-app
APP_VERSION=dev
