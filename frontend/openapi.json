      "Queue": {
        "properties": {
          "waiting": {
            "title": "Waiting",
            "type": "integer"
          },
          "running": {
            "title": "Running",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "workers": {
            "title": "Workers",
            "type": "integer"
          }
        },
        "required": [
          "waiting",
          "running",
          "failed",
          "workers"
        ],
        "title": "Queue",
        "type": "object"
      },
      "TechnicalSettingsSchema": {
        "properties": {
          "time_limit_cap_seconds": {
            "maximum": 86400,
            "minimum": 1,
            "title": "Time Limit Cap Seconds",
            "type": "integer"
          },
          "backup_time": {
            "examples": [
              "02:00"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Backup Time",
            "type": "string"
          },
          "backup_retention_days": {
            "maximum": 3650,
            "minimum": 1,
            "title": "Backup Retention Days",
            "type": "integer"
          },
          "close_time": {
            "examples": [
              "02:00"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Close Time",
            "type": "string"
          }
        },
        "required": [
          "time_limit_cap_seconds",
          "backup_time",
          "backup_retention_days",
